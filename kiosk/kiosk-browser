#!/bin/sh
# Weston käivitab selle oma Waylandi keskkonnas.
URL_FILE="$HOME/.config/kiosk-url"
if [ ! -r "$URL_FILE" ]; then
    echo "Kiosk: puudub $URL_FILE" >&2
    exit 1
fi
URL=$(head -n 1 "$URL_FILE")
case "$URL" in
    http://*|https://*) ;;
    *) echo "Kiosk: vale URL: $URL" >&2; exit 1 ;;
esac

while :; do
    /usr/bin/cog --platform=wl --webprocess-failure=restart "$URL" \
        >> "$HOME/cog.log" 2>&1
    echo "Cog lõppes, uus katse 5 sekundi pärast" >> "$HOME/cog.log"
    sleep 5
done
